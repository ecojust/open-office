# Keep redistributed sources, patches and their recorded digests byte-identical
# on Windows and macOS. Binary assets are detected and left untouched.
* text=auto eol=lf
# Preserve upstream license bytes used by published-archive checksum evidence.
public/legal/rust/unicode-script@0.5.8/LICENSE-* -text
# Preserve OfficeWord sources and redistributed notices byte-for-byte for the
# source/artifact and upstream license manifests, including original CRLFs.
vendor/office-word/** -text
public/legal/rust/** -text
public/legal/npm/** -text
public/legal/wordcraft/** -text
vendor/office-sheet/** -text
vendor/office-presentation/** -text
vendor/office-pdf/** -text
public/legal/gridcraft/** -text
public/legal/deckcraft/** -text
public/legal/office-pdf/** -text
assets/fonts/** -text
# Verbatim upstream notices/source tables retain their original whitespace.
public/legal/npm/tslib@1.14.1/*.txt whitespace=cr-at-eol,-blank-at-eof
assets/fonts/deck/LICENSE-LXGW-WenKai.txt whitespace=-blank-at-eol
public/legal/deckcraft/fonts/LICENSE-LXGW-WenKai.txt whitespace=-blank-at-eol
public/legal/deckcraft/dependencies/*/upstream-LICENSE whitespace=-blank-at-eol
vendor/office-presentation/crates/engine/Cargo.toml whitespace=-blank-at-eof
vendor/office-presentation/crates/vp9/src/spec_tables.rs whitespace=-blank-at-eof
