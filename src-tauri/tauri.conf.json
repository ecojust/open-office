{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Open Office",
  "version": "0.23.0",
  "identifier": "com.ecojust.openoffice",
  "build": {
    "beforeDevCommand": "npm run build",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../desktop-shell"
  },
  "app": {
    "windows": [],
    "security": {
      "capabilities": [],
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "app",
      "dmg"
    ],
    "category": "Productivity",
    "shortDescription": "Private offline document editing",
    "resources": {
      "../dist/": "frontend/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "displayLanguageSelector": true,
        "languages": [
          "SimpChinese",
          "English"
        ]
      }
    },
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": "-",
      "infoPlist": "Info.plist"
    }
  }
}
