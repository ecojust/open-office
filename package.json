{
  "name": "open-office",
  "version": "0.19.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5198 --strictPort",
    "typecheck": "vue-tsc --noEmit",
    "icons:build": "node scripts/build-office-icons.mjs",
    "icons:check": "node scripts/build-office-icons.mjs --check",
    "build": "npm run branding:check && npm run engine:check && npm run icons:check && npm run word:build && npm run sheet:build && npm run deck:build && npm run pdf:build && npm run typecheck && vite build && npm run engine:check:dist && npm run branding:check:dist",
    "preview": "vite preview --host 127.0.0.1 --port 4198 --strictPort",
    "test": "npm run typecheck && node --test --experimental-test-isolation=none tests/*.test.mjs",
    "pdf:build": "node scripts/build-office-pdf.mjs",
    "desktop:prepare": "npm run build",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "test:browser": "node tests/browser/office-pdf-native-helper.cjs",
    "test:browser:mcp": "node tests/browser/mcp-editors.cjs",
    "test:compatibility": "node tests/browser/office-word-native-helper.cjs && node tests/browser/office-sheet-native-helper.cjs && node tests/browser/office-presentation-native-helper.cjs",
    "test:compatibility:onlyoffice": "node tests/compatibility/onlyoffice-desktop.mjs",
    "predev": "npm run word:build && npm run sheet:build && npm run deck:build && npm run pdf:build",
    "word:build": "node scripts/build-office-word.mjs",
    "word:check": "node scripts/build-office-word.mjs --check",
    "test:browser:word-engine": "node tests/browser/office-word-engine.cjs",
    "test:browser:word-embedded": "node tests/browser/office-word-embedded-ui.cjs",
    "test:browser:word": "node tests/browser/office-word-engine.cjs",
    "sheet:build": "node scripts/build-office-sheet.mjs",
    "sheet:check": "node scripts/build-office-sheet.mjs --check",
    "test:browser:sheet-engine": "node tests/browser/office-sheet-engine.cjs",
    "test:browser:sheet-native-helper": "node tests/browser/office-sheet-native-helper.cjs",
    "deck:build": "node scripts/build-office-presentation.mjs",
    "deck:check": "node scripts/build-office-presentation.mjs --check",
    "test:browser:ppt-engine": "node tests/browser/office-presentation-native-helper.cjs",
    "test:browser:ppt-templates": "node tests/browser/presentation-templates.cjs",
    "test:browser:ppt-templates-storage": "node tests/browser/presentation-template-storage.cjs",
    "test:browser:ppt-render-cache": "node tests/browser/presentation-render-cache.cjs",
    "test:browser:live-tabs": "node tests/browser/live-tab-switching.cjs",
    "engine:check": "node scripts/check-editor-boundaries.mjs",
    "engine:check:dist": "node scripts/check-editor-boundaries.mjs --dist",
    "pdf:check": "node scripts/build-office-pdf.mjs --check",
    "test:browser:pdf": "node tests/browser/office-pdf-native-helper.cjs",
    "test:browser:notes": "node tests/browser/notebook-editor.cjs",
    "test:browser:schedule": "node tests/browser/project-schedule.cjs",
    "test:browser:pdf-toolbar": "node tests/browser/office-pdf-toolbar.cjs",
    "test:browser:pdf-drafts": "node tests/browser/pdf-comment-drafts.cjs",
    "test:browser:ui-style": "node tests/browser/office-ui-style.cjs",
    "branding:check": "node scripts/check-office-branding.mjs",
    "branding:check:dist": "node scripts/check-office-branding.mjs --no-source --dist"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.3",
    "fflate": "0.8.2",
    "vue": "3.5.22"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.2",
    "@types/node": "24.7.0",
    "@vitejs/plugin-vue": "6.0.1",
    "@xmldom/xmldom": "0.9.12",
    "pdf-lib": "1.17.1",
    "playwright": "1.62.1",
    "pngjs": "7.0.0",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vue-tsc": "3.1.0"
  }
}
