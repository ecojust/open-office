{
  "name": "open-office",
  "version": "0.10.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5198 --strictPort",
    "typecheck": "vue-tsc --noEmit",
    "icons:build": "node scripts/build-office-icons.mjs",
    "icons:check": "node scripts/build-office-icons.mjs --check",
    "build": "npm run engine:check && npm run assets && npm run icons:check && npm run word:build && npm run sheet:build && npm run deck:build && npm run typecheck && vite build && npm run engine:check:dist",
    "preview": "vite preview --host 127.0.0.1 --port 4198 --strictPort",
    "test": "npm run typecheck && node --test --experimental-test-isolation=none tests/*.test.mjs && npm run pdf:test",
    "pdf:build": "node scripts/build-pdf-backend.mjs",
    "pdf:ensure": "node scripts/ensure-pdf-backend.mjs",
    "desktop:prepare": "npm run pdf:build",
    "predesktop:dev": "npm run pdf:ensure",
    "desktop:dev": "tauri dev",
    "predesktop:build": "npm run pdf:ensure",
    "desktop:build": "tauri build",
    "assets": "node scripts/copy-pdf-assets.mjs",
    "postinstall": "npm run assets",
    "pdf:test": "node scripts/test-pdf-backend.mjs",
    "test:browser": "node tests/browser/pdf-ui.cjs",
    "test:browser:pdf-memory": "node tests/browser/pdf-memory.cjs",
    "test:compatibility": "node tests/browser/wordcraft-native-helper.cjs && node tests/browser/gridcraft-native-helper.cjs && node tests/browser/deckcraft-native-helper.cjs",
    "test:compatibility:onlyoffice": "node tests/compatibility/onlyoffice-desktop.mjs",
    "predev": "npm run word:build && npm run sheet:build && npm run deck:build",
    "word:build": "node scripts/build-wordcraft.mjs",
    "word:check": "node scripts/build-wordcraft.mjs --check",
    "test:browser:word-engine": "node tests/browser/wordcraft-engine.cjs",
    "test:browser:word-embedded": "node tests/browser/wordcraft-embedded-ui.cjs",
    "test:browser:wordcraft": "node tests/browser/wordcraft-engine.cjs",
    "sheet:build": "node scripts/build-gridcraft.mjs",
    "sheet:check": "node scripts/build-gridcraft.mjs --check",
    "test:browser:sheet-engine": "node tests/browser/gridcraft-engine.cjs",
    "test:browser:sheet-native-helper": "node tests/browser/gridcraft-native-helper.cjs",
    "deck:build": "node scripts/build-deckcraft.mjs",
    "deck:check": "node scripts/build-deckcraft.mjs --check",
    "test:browser:ppt-engine": "node tests/browser/deckcraft-native-helper.cjs",
    "engine:check": "node scripts/check-editor-boundaries.mjs",
    "engine:check:dist": "node scripts/check-editor-boundaries.mjs --dist"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.3",
    "pdfjs-dist": "6.4.299",
    "vue": "3.5.22"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.2",
    "@types/node": "24.7.0",
    "@vitejs/plugin-vue": "6.0.1",
    "playwright": "1.62.1",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vue-tsc": "3.1.0",
    "fflate": "0.8.2",
    "pdf-lib": "1.17.1"
  }
}
