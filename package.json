{
  "name": "open-office",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5198 --strictPort",
    "typecheck": "vue-tsc --noEmit",
    "runtime:fetch": "node scripts/fetch-office-runtime.mjs",
    "build": "npm run assets && npm run runtime:fetch && npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4198 --strictPort",
    "test": "npm run typecheck && node --test --experimental-test-isolation=none tests/*.test.mjs && npm run pdf:test",
    "pdf:build": "node scripts/build-pdf-backend.mjs",
    "pdf:ensure": "node scripts/ensure-pdf-backend.mjs",
    "desktop:prepare": "npm run runtime:fetch && npm run pdf:build",
    "predesktop:dev": "npm run runtime:fetch && npm run pdf:ensure",
    "desktop:dev": "tauri dev",
    "predesktop:build": "npm run pdf:ensure",
    "desktop:build": "tauri build",
    "assets": "node scripts/copy-pdf-assets.mjs",
    "postinstall": "npm run assets",
    "pdf:test": "node scripts/test-pdf-backend.mjs",
    "test:browser": "node tests/browser/pdf-ui.cjs",
    "test:browser:ppt": "node tests/browser/presentation-ui.cjs",
    "test:browser:impress": "node tests/browser/impress-engine.cjs",
    "test:browser:ppt-workbench": "node tests/browser/presentation-workbench.cjs",
    "test:browser:ppt-workbench-ui": "node tests/browser/presentation-workbench-ui.cjs",
    "test:browser:ppt-player": "node tests/browser/presentation-player.cjs",
    "test:browser:ppt-package": "node tests/browser/pptx-package.cjs",
    "test:browser:ppt-chart-data": "node tests/browser/pptx-chart-data.cjs",
    "test:browser:ppt-chart-native": "node tests/browser/pptx-chart-native.cjs",
    "test:browser:ppt-native-contract": "node tests/browser/presentation-native-contract.cjs",
    "test:browser:word": "node tests/browser/writer-workbench.cjs",
    "test:browser:sheet": "node tests/browser/calc-workbench.cjs",
    "test:browser:office-native-contract": "node tests/browser/office-workbench-native-contract.cjs",
    "test:browser:workbench-drafts": "node tests/browser/workbench-drafts.cjs",
    "test:browser:office-ui": "node tests/browser/word-sheet-ui.cjs",
    "test:browser:office-drafts": "node tests/browser/workbench-drafts.cjs",
    "test:compatibility": "node tests/compatibility/run.cjs"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.3",
    "fflate": "0.8.2",
    "pdfjs-dist": "6.4.299",
    "vue": "3.5.22"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.2",
    "@types/node": "24.7.0",
    "@vitejs/plugin-vue": "6.0.1",
    "playwright": "1.62.1",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vue-tsc": "3.1.0"
  }
}
