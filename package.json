{
  "name": "open-office",
  "version": "0.8.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5198 --strictPort",
    "typecheck": "vue-tsc --noEmit",
    "runtime:fetch": "node scripts/fetch-office-runtime.mjs",
    "build": "npm run assets && npm run runtime:fetch && npm run word:build && npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4198 --strictPort",
    "test": "npm run typecheck && node --test --experimental-test-isolation=none tests/*.test.mjs && npm run pdf:test",
    "pdf:build": "node scripts/build-pdf-backend.mjs",
    "pdf:ensure": "node scripts/ensure-pdf-backend.mjs",
    "desktop:prepare": "npm run runtime:fetch && npm run pdf:build",
    "predesktop:dev": "npm run runtime:fetch && npm run pdf:ensure",
    "desktop:dev": "tauri dev",
    "predesktop:build": "npm run pdf:ensure",
    "desktop:build": "tauri build",
    "assets": "node scripts/copy-pdf-assets.mjs",
    "postinstall": "npm run assets",
    "pdf:test": "node scripts/test-pdf-backend.mjs",
    "test:browser": "node tests/browser/pdf-ui.cjs",
    "test:browser:pdf-memory": "node tests/browser/pdf-memory.cjs",
    "test:browser:office-memory": "node tests/browser/office-memory.cjs",
    "test:browser:ppt": "node tests/browser/presentation-ui.cjs",
    "test:browser:ppt-independent": "node tests/browser/standalone-presentation.cjs",
    "test:browser:ppt-complex": "node tests/browser/standalone-presentation-complex.cjs",
    "test:browser:ppt-smartart": "node tests/browser/smartart-preview.cjs",
    "test:browser:ppt-rich-text": "node tests/browser/presentation-rich-text.cjs",
    "test:browser:impress": "node tests/browser/impress-engine.cjs",
    "test:browser:ppt-workbench": "node tests/browser/presentation-workbench.cjs",
    "test:browser:ppt-workbench-ui": "node tests/browser/presentation-workbench-ui.cjs",
    "test:browser:ppt-player": "node tests/browser/presentation-player.cjs",
    "test:browser:ppt-package": "node tests/browser/pptx-package.cjs",
    "test:browser:ppt-chart-data": "node tests/browser/pptx-chart-data.cjs",
    "test:browser:ppt-chart-native": "node tests/browser/pptx-chart-native.cjs",
    "test:browser:ppt-native-contract": "node tests/browser/presentation-native-contract.cjs",
    "test:browser:word": "node tests/browser/writer-workbench.cjs",
    "test:browser:word-independent": "node tests/browser/standalone-word.cjs",
    "test:browser:word-codec": "node tests/browser/independent-word-codec.cjs",
    "test:browser:word-import-performance": "node tests/browser/independent-word-import-performance.cjs",
    "test:browser:word-libreoffice": "node tests/browser/independent-word-libreoffice.cjs",
    "test:browser:word-indentation": "node tests/browser/independent-word-indentation.cjs",
    "test:browser:word-character-format": "node tests/browser/independent-word-character-format.cjs",
    "test:browser:word-highlight": "node tests/browser/independent-word-highlight.cjs",
    "test:browser:word-background": "node tests/browser/independent-word-background.cjs",
    "test:browser:word-marker": "node tests/browser/independent-word-marker.cjs",
    "test:browser:word-spacing": "node tests/browser/independent-word-spacing.cjs",
    "test:browser:word-case": "node tests/browser/independent-word-case.cjs",
    "test:browser:word-kerning": "node tests/browser/independent-word-kerning.cjs",
    "test:browser:word-underline": "node tests/browser/independent-word-underline.cjs",
    "test:browser:word-underline-color": "node tests/browser/independent-word-underline-color.cjs",
    "test:browser:word-baseline-offset": "node tests/browser/independent-word-baseline-offset.cjs",
    "test:browser:word-paragraph-spacing": "node tests/browser/independent-word-paragraph-spacing.cjs",
    "test:browser:word-line-rule": "node tests/browser/independent-word-line-rule.cjs",
    "test:browser:word-auto-color": "node tests/browser/independent-word-auto-color.cjs",
    "test:browser:word-page-settings": "node tests/browser/independent-word-page-settings.cjs",
    "test:browser:word-rust": "node tests/browser/word-rust-package.cjs",
    "test:native:word-package": "node scripts/word-package-native-smoke.mjs",
    "test:browser:sheet": "node tests/browser/calc-workbench.cjs",
    "test:browser:office-native-contract": "node tests/browser/office-workbench-native-contract.cjs",
    "test:browser:workbench-drafts": "node tests/browser/workbench-drafts.cjs",
    "test:browser:office-ui": "node tests/browser/word-sheet-ui.cjs",
    "test:browser:office-drafts": "node tests/browser/workbench-drafts.cjs",
    "test:compatibility": "node tests/compatibility/run.cjs",
    "test:compatibility:onlyoffice": "node tests/compatibility/onlyoffice-desktop.mjs",
    "predev": "npm run word:build",
    "word:build": "node scripts/build-wordcraft.mjs",
    "word:check": "node scripts/build-wordcraft.mjs --check",
    "test:browser:word-engine": "node tests/browser/wordcraft-engine.cjs",
    "test:browser:word-embedded": "node tests/browser/wordcraft-embedded-ui.cjs",
    "test:browser:wordcraft": "node tests/browser/wordcraft-engine.cjs",
    "test:native:word-engine": "node scripts/rust-word-native-smoke.mjs"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "1.1.1",
    "@tauri-apps/api": "2.12.3",
    "fflate": "0.8.2",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.4.299",
    "vue": "3.5.22"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.2",
    "@types/node": "24.7.0",
    "@vitejs/plugin-vue": "6.0.1",
    "playwright": "1.62.1",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vue-tsc": "3.1.0"
  }
}
