<?xml version="1.0" encoding="utf-8"?>
<!--
  OfficePdf MSI (WiX Toolset v5: `dotnet tool install -g wix`). Built by package.ps1:

    wix build office-pdf.wxs installer-ui.wxs -arch x64 -d Version=1.2.3 -d BinDir=... -d ModelsDir=... -d IconPath=... -o out.msi

  Per-machine install into Program Files, a Start Menu shortcut, a desktop shortcut (on by default,
  optional, and an update keeps it only if it is still there), an App Paths entry, OfficePdf registered as a PDF handler (offered under "Open with"
  and in Default apps, never forced as the default), "Edit with OfficePdf" on PDF files'
  right-click menu and "Create PDF with OfficePdf…" on image files' right-click menu (both on by
  default, optional, and an update keeps the installed version's choice). Files opened with
  OfficePdf arrive on its command line.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
      Name="Open Office"
      Manufacturer="Learning Machines LLC"
      Version="$(var.Version)"
      UpgradeCode="EA00C367-7270-4C50-9D8B-A7A5C88AD27F"
      Scope="perMachine"
      Compressed="yes"
      Language="1033">
    <SummaryInformation Description="OfficePdf PDF workbench" Manufacturer="Learning Machines LLC" />
    <!-- HKLM registrations must never point into a per-user installation (#305). Allow removal
         of an existing installation even if an older MSI let it install per-user. -->
    <Launch Condition="ALLUSERS = 1 OR (Installed AND REMOVE = &quot;ALL&quot;)"
        Message="OfficePdf must be installed for all users. Run setup with administrator privileges and ALLUSERS=1; per-user installation is not supported." />
    <!-- Same-version upgrades let successive pre-releases of one X.Y.Z replace each other
         (MSI versions are numeric, so 1.2.3-rc.1 and 1.2.3-rc.2 are both 1.2.3). -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
        DowngradeErrorMessage="A newer version of OfficePdf is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <!-- Windows Installer requires an Icon id ending in .ico or .exe, or advertised shortcuts and
         Add/Remove Programs show a blank icon (#57). -->
    <Icon Id="OfficePdfIcon.ico" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="OfficePdfIcon.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/ecojust/open-office" />
    <Property Id="ARPURLUPDATEINFO" Value="https://github.com/ecojust/open-office" />
    <Property Id="ARPHELPLINK" Value="https://github.com/ecojust/open-office" />
    <!-- Desktop shortcut (#143): on by default for a first install, a checkbox in the full-UI
         welcome dialog, and INSTALLDESKTOPSHORTCUT=0 on the msiexec command line for unattended
         installs. Secure, so the choice made in the (unelevated) UI reaches the elevated install.
         An update keeps the shortcut only if it is still on the desktop (#1058): the launcher
         updates with /passive and no properties, so deleting the shortcut is the only way its
         users can say no. A value given on the command line wins. -->
    <Property Id="INSTALLDESKTOPSHORTCUT" Secure="yes" />
    <Property Id="EXISTINGDESKTOPSHORTCUT">
      <DirectorySearch Id="DesktopSearch" Path="[DesktopFolder]" Depth="0">
        <FileSearch Name="OfficePdf.lnk" />
      </DirectorySearch>
    </Property>
    <SetProperty Id="INSTALLDESKTOPSHORTCUT" Value="1" After="AppSearch" Sequence="first"
        Condition="NOT INSTALLDESKTOPSHORTCUT AND (NOT WIX_UPGRADE_DETECTED OR EXISTINGDESKTOPSHORTCUT)" />
    <!-- The File Explorer menus: "Edit with OfficePdf" for PDF files (#682) and "Create PDF with
         OfficePdf…" for images (#190). Each is on by default for a first install and has a property
         to leave it out of unattended installs: INSTALLPDFCONTEXTMENU=0 (also a welcome-dialog
         checkbox) and INSTALLIMAGECONTEXTMENU=0. Secure, like the desktop shortcut's.
         An update keeps the installed version's choice (#305) by looking for the menu's registry
         key, the way the desktop shortcut looks for its file: AppSearch runs before the old version
         is removed. Releases from before a menu existed (the PDF one came in 0.7.1, the image one in
         0.4.0) never had the key, so updating from one of them counts as a first install; the
         OnlyDetect rows below tell them apart. A value given on the command line wins. -->
    <Upgrade Id="EA00C367-7270-4C50-9D8B-A7A5C88AD27F">
      <UpgradeVersion Minimum="0.7.1" IncludeMinimum="yes" OnlyDetect="yes" Property="PDFCONTEXTMENURELEASE" />
      <UpgradeVersion Minimum="0.4.0" IncludeMinimum="yes" OnlyDetect="yes" Property="IMAGECONTEXTMENURELEASE" />
    </Upgrade>
    <Property Id="INSTALLPDFCONTEXTMENU" Secure="yes" />
    <Property Id="EXISTINGPDFCONTEXTMENU">
      <RegistrySearch Id="PdfContextMenuSearch" Root="HKLM" Key="Software\Classes\SystemFileAssociations\.pdf\shell\OfficePdf.Edit" Type="raw" />
    </Property>
    <SetProperty Id="INSTALLPDFCONTEXTMENU" Value="1" After="AppSearch" Sequence="first"
        Condition="NOT INSTALLPDFCONTEXTMENU AND (NOT PDFCONTEXTMENURELEASE OR EXISTINGPDFCONTEXTMENU)" />
    <Property Id="INSTALLIMAGECONTEXTMENU" Secure="yes" />
    <Property Id="EXISTINGIMAGECONTEXTMENU">
      <RegistrySearch Id="ImageContextMenuSearch" Root="HKLM" Key="Software\Classes\SystemFileAssociations\.png\shell\OfficePdf.CreatePdf" Type="raw" />
    </Property>
    <SetProperty Id="INSTALLIMAGECONTEXTMENU" Value="1" After="AppSearch" Sequence="first"
        Condition="NOT INSTALLIMAGECONTEXTMENU AND (NOT IMAGECONTEXTMENURELEASE OR EXISTINGIMAGECONTEXTMENU)" />
    <UIRef Id="OfficePdfInstallerUI" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="Open Office">
        <Directory Id="ModelsFolder" Name="models" />
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />
    <StandardDirectory Id="DesktopFolder" />

    <Feature Id="Main" Title="Open Office" Level="1">
      <ComponentGroupRef Id="OfficePdfFiles" />
      <ComponentGroupRef Id="OfficePdfModels" />
    </Feature>
  </Package>

  <Fragment>
    <ComponentGroup Id="OfficePdfFiles" Directory="INSTALLFOLDER">
      <Component Id="OfficePdfApp" Guid="E724C1C6-091F-4E21-A685-80D089FDBE21">
        <File Id="OfficePdfExe" Source="$(var.BinDir)\office-pdf.exe" KeyPath="yes" />

        <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\office-pdf.exe" Value="[#OfficePdfExe]" Type="string" />

        <!-- PDF files (#107): OfficePdf is offered under "Open with" and in Settings ▸ Default
             apps, through Windows' Default Programs registration (a ProgID, OpenWithProgids,
             Capabilities and RegisteredApplications). It never takes over an existing default:
             .pdf's own default value is left alone, and the user chooses. Without this, the only
             OfficePdf entry to pick was the advertised Start Menu shortcut, which Windows can't
             run as a file handler ("This app can't run on your PC"). -->
        <RegistryValue Root="HKLM" Key="Software\Classes\OfficePdf.Document" Value="PDF Document" Type="string" />
        <!-- A negative index selects the stable icon resource ID, rather than its position.
             Resource 1 is the app's lion; resource 2 is the PDF document (build.rs). -->
        <RegistryValue Root="HKLM" Key="Software\Classes\OfficePdf.Document\DefaultIcon" Value="&quot;[#OfficePdfExe]&quot;,-2" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\OfficePdf.Document\shell\open\command" Value="&quot;[#OfficePdfExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.pdf\OpenWithProgids" Name="OfficePdf.Document" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\office-pdf.exe" Name="FriendlyAppName" Value="Open Office" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\office-pdf.exe\DefaultIcon" Value="&quot;[#OfficePdfExe]&quot;,-2" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\office-pdf.exe\SupportedTypes" Name=".pdf" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\office-pdf.exe\shell\open\command" Value="&quot;[#OfficePdfExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\OfficePdf\Capabilities" Name="ApplicationName" Value="Open Office" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\OfficePdf\Capabilities" Name="ApplicationDescription" Value="Open-source PDF workbench" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\OfficePdf\Capabilities" Name="ApplicationIcon" Value="[#OfficePdfExe],0" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\OfficePdf\Capabilities\FileAssociations" Name=".pdf" Value="OfficePdf.Document" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\RegisteredApplications" Name="Open Office" Value="Software\OfficePdf\Capabilities" Type="string" />
      </Component>

      <!-- Shortcuts (#143) are plain links to office-pdf.exe, not advertised MSI shortcuts: advertised
           ones point at a Windows Installer descriptor rather than the program, which Windows can't
           use as a file handler (#107), and 0.2.1's advertised one went missing from the Start menu
           (#143). Each has its own component with an HKLM key path, so Windows Installer removes it
           on uninstall; in this per-machine package both folders are the all-users ones. -->
      <Component Id="OfficePdfStartMenuShortcut" Directory="ProgramMenuFolder" Guid="DC028192-C233-4F99-9A77-ED458C60DF26">
        <Shortcut Id="StartMenuShortcut" Name="Open Office" Description="OfficePdf PDF workbench"
            Target="[#OfficePdfExe]" WorkingDirectory="INSTALLFOLDER" Icon="OfficePdfIcon.ico" IconIndex="0" />
        <RegistryValue Root="HKLM" Key="Software\OfficePdf\Shortcuts" Name="StartMenu" Type="integer" Value="1" KeyPath="yes" />
      </Component>

      <Component Id="OfficePdfDesktopShortcut" Directory="DesktopFolder" Guid="F6948627-32AB-4D78-8865-0FDF417CE442"
          Condition="INSTALLDESKTOPSHORTCUT = 1">
        <Shortcut Id="DesktopShortcut" Name="Open Office" Description="OfficePdf PDF workbench"
            Target="[#OfficePdfExe]" WorkingDirectory="INSTALLFOLDER" Icon="OfficePdfIcon.ico" IconIndex="0" />
        <RegistryValue Root="HKLM" Key="Software\OfficePdf\Shortcuts" Name="Desktop" Type="integer" Value="1" KeyPath="yes" />
      </Component>

      <!-- PDF context menu (#682): "Edit with OfficePdf" opens the file in OfficePdf whichever app is
           the default for .pdf, which it leaves alone (SystemFileAssociations, like the image
           menu). Several PDFs selected (up to 15, Windows' limit for this kind of entry) start one
           launch each, and the single-instance hand-off opens them as tabs of one window. On
           Windows 11 the entry is under "Show more options": the first-level menu only takes
           packaged apps' (IExplorerCommand) entries. Its own component with an HKLM key path, so
           INSTALLPDFCONTEXTMENU=0 leaves it out and uninstall removes it. -->
      <Component Id="OfficePdfPdfContextMenu" Guid="439F084F-657D-4AC2-A4CC-F099C518D71F"
          Condition="INSTALLPDFCONTEXTMENU = 1">
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.pdf\shell\OfficePdf.Edit" Value="Edit with OfficePdf" Type="string" KeyPath="yes" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.pdf\shell\OfficePdf.Edit" Name="Icon" Value="&quot;[#OfficePdfExe]&quot;,0" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.pdf\shell\OfficePdf.Edit" Name="MultiSelectModel" Value="Document" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.pdf\shell\OfficePdf.Edit\command" Value="&quot;[#OfficePdfExe]&quot; &quot;%1&quot;" Type="string" />
      </Component>

      <!-- Image context menu (#190): "Create PDF with OfficePdf…" opens the DPI chooser, without
           changing image file defaults. Its own component with an HKLM key path, so
           INSTALLIMAGECONTEXTMENU=0 leaves it out and uninstall removes it. These rows were in
           OfficePdfApp up to 0.7.1; moving them is safe because MajorUpgrade removes the old version
           before installing (afterInstallValidate), so no old row is left behind. -->
      <Component Id="OfficePdfImageContextMenu" Guid="1B783BF3-12DF-4588-AF80-E2CEA8BC1E5A"
          Condition="INSTALLIMAGECONTEXTMENU = 1">
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.png\shell\OfficePdf.CreatePdf" Value="Create PDF with OfficePdf…" Type="string" KeyPath="yes" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.png\shell\OfficePdf.CreatePdf" Name="MultiSelectModel" Value="Single" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.png\shell\OfficePdf.CreatePdf\command" Value="&quot;[#OfficePdfExe]&quot; --create-images &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.jpg\shell\OfficePdf.CreatePdf" Value="Create PDF with OfficePdf…" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.jpg\shell\OfficePdf.CreatePdf" Name="MultiSelectModel" Value="Single" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.jpg\shell\OfficePdf.CreatePdf\command" Value="&quot;[#OfficePdfExe]&quot; --create-images &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.jpeg\shell\OfficePdf.CreatePdf" Value="Create PDF with OfficePdf…" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.jpeg\shell\OfficePdf.CreatePdf" Name="MultiSelectModel" Value="Single" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.jpeg\shell\OfficePdf.CreatePdf\command" Value="&quot;[#OfficePdfExe]&quot; --create-images &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.tif\shell\OfficePdf.CreatePdf" Value="Create PDF with OfficePdf…" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.tif\shell\OfficePdf.CreatePdf" Name="MultiSelectModel" Value="Single" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.tif\shell\OfficePdf.CreatePdf\command" Value="&quot;[#OfficePdfExe]&quot; --create-images &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.tiff\shell\OfficePdf.CreatePdf" Value="Create PDF with OfficePdf…" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.tiff\shell\OfficePdf.CreatePdf" Name="MultiSelectModel" Value="Single" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.tiff\shell\OfficePdf.CreatePdf\command" Value="&quot;[#OfficePdfExe]&quot; --create-images &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.gif\shell\OfficePdf.CreatePdf" Value="Create PDF with OfficePdf…" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.gif\shell\OfficePdf.CreatePdf" Name="MultiSelectModel" Value="Single" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.gif\shell\OfficePdf.CreatePdf\command" Value="&quot;[#OfficePdfExe]&quot; --create-images &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.bmp\shell\OfficePdf.CreatePdf" Value="Create PDF with OfficePdf…" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.bmp\shell\OfficePdf.CreatePdf" Name="MultiSelectModel" Value="Single" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.bmp\shell\OfficePdf.CreatePdf\command" Value="&quot;[#OfficePdfExe]&quot; --create-images &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.jp2\shell\OfficePdf.CreatePdf" Value="Create PDF with OfficePdf…" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.jp2\shell\OfficePdf.CreatePdf" Name="MultiSelectModel" Value="Single" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.jp2\shell\OfficePdf.CreatePdf\command" Value="&quot;[#OfficePdfExe]&quot; --create-images &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.j2k\shell\OfficePdf.CreatePdf" Value="Create PDF with OfficePdf…" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.j2k\shell\OfficePdf.CreatePdf" Name="MultiSelectModel" Value="Single" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.j2k\shell\OfficePdf.CreatePdf\command" Value="&quot;[#OfficePdfExe]&quot; --create-images &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.jpx\shell\OfficePdf.CreatePdf" Value="Create PDF with OfficePdf…" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.jpx\shell\OfficePdf.CreatePdf" Name="MultiSelectModel" Value="Single" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.jpx\shell\OfficePdf.CreatePdf\command" Value="&quot;[#OfficePdfExe]&quot; --create-images &quot;%1&quot;" Type="string" />
      </Component>

      <Component Id="OfficePdfCli">
        <File Id="OfficePdfCliExe" Source="$(var.BinDir)\office-pdf-cli.exe" KeyPath="yes" />
      </Component>
      <!-- The embedded PDF icon's ISC notice and project licences travel with the binaries. -->
      <Component Id="OfficePdfDocumentIconLicense">
        <File Id="OfficePdfDocumentIconLicenseFile" Source="$(var.BinDir)\LICENSE-document.txt" KeyPath="yes" />
      </Component>
      <Component Id="OfficePdfMitLicense">
        <File Id="OfficePdfMitLicenseFile" Source="$(var.BinDir)\LICENSE-MIT" KeyPath="yes" />
      </Component>
      <Component Id="OfficePdfApacheLicense">
        <File Id="OfficePdfApacheLicenseFile" Source="$(var.BinDir)\LICENSE-APACHE" KeyPath="yes" />
      </Component>
      <Component Id="OfficePdfNotice">
        <File Id="OfficePdfNoticeFile" Source="$(var.BinDir)\NOTICE" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <!-- OCR models (#103), with their licences and ATTRIBUTION.txt, in models\ beside office-pdf.exe
         where the app looks for them: every file `cargo xtask models` fetched (package.ps1), one
         component each, so new models ship without naming them here. -->
    <ComponentGroup Id="OfficePdfModels" Directory="ModelsFolder">
      <Files Include="$(var.ModelsDir)\*" />
    </ComponentGroup>
  </Fragment>
</Wix>
