  "resolvedFindings": [
    "Writer ordinary list create/remove/promote/demote/restart uses native list model and preserves unrelated content.",
    "Native level slots replace non-undoable direct NumberingLevel writes.",
    "Internal initialized numbering creation is excluded from history, while actual binding remains undoable; bounded document-owned references survive undo and release after successful close.",
    "Known ordinary DOCX Symbol and ODT current-level list representations remain editable after reopening, without permitting arbitrary templates.",
    "Calc mixed/unknown formatting is distinct from anchor formatting; an explicit same-color action works.",
    "Rich cell character properties are written to actual native text ranges, preserving unmodified properties and content.",
    "General number format resets after native locale normalization within the same undo group."
  ],
  "retainedFailureEvidence": [
    "test-results/list-final/tests-sandbox-denied.log",
    "test-results/list-production-word-ui/ui-report.json",
