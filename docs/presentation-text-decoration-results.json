  "stages": "Initial 148-browser and 80-PDF evidence have their own source hashes. Only scene/PDF changed later, covered by final 6 boundary scenes, full tests and 8 production UI groups / 165 actual downloaded PDF checks. UI PPTX bytes equal earlier native-opened artifacts.",
  "resolvedFindings": [
    "PDF half-alpha glyph/strike overlap was double composited",
    "Negative insets were clipped by the new Form box",
    "Coincident Form and text clip double-antialiased rotated edges",
    "Whole-string header/footer edits removed PAGE fields",
    "PDF page selection discarded AcroForm roots",
    "Empty PDF calculation order arrays were misclassified; merged form defaults and duplicate names needed isolation"
  ],
  "initialTestIssuesPreserved": [
    "Range first launch used an inactive default port",
    "Range JSON equality incorrectly depended on object-key insertion order",
    "Old alpha test counted new text-decoration paths as shape borders",
    "Word UI selectors expected generic header/footer wording and the wrong active tab on reopening"
  ],
  "limits": [
    "No arbitrary complex lossless compatibility or complete reference-app feature parity",
    "Unsupported wavy/words/custom underline material retained in XML and warned; ordinary geometry is not per-font exact",
    "SmartArt cached decoration remains unsupported",
    "Writer sidebar edits only one ordinary run; field/link/format/line boundaries protected",
    "Complex PDF trees, actions or XFA page assembly refused",
    "No new Windows/macOS installer validation or release"
